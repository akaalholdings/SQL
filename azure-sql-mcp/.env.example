AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DEFAULT_DATABASE=appdb
AZURE_SQL_ALLOWED_DATABASES=appdb,reportingdb
AZURE_SQL_AUTH_MODE=entra-default
AZURE_SQL_ACCESS_MODE=restricted
AZURE_SQL_PROFILE=triage
AZURE_SQL_TOOL_GROUPS=core,performance
AZURE_SQL_WRITE_POLICY=disabled
AZURE_SQL_DATABASE_POLICY_FILE=/absolute/path/to/local-database-policy.json
AZURE_SQL_PERFORMANCE_STATE_DIR=~/.azure-sql-mcp/state
AZURE_SQL_PLAN_APPLY_KILL_SWITCH=true
AZURE_SQL_TRUST_SERVER_CERTIFICATE=false
AZURE_SQL_QUERY_TIMEOUT_SECONDS=30
AZURE_SQL_ROW_LIMIT=200
AZURE_SQL_AUDIT_DIR=~/.azure-sql-mcp/audit
AZURE_SQL_AUDIT_FULL_SQL=false
AZURE_SQL_ENABLE_REMOTE_ADMIN=false

# Required only for SSE/streamable HTTP. Prefer the environment because command
# line values can be visible in process listings.
AZURE_SQL_MCP_BEARER_TOKEN=

# Existing-database scoped DBA alternative (prefer local stdio):
# AZURE_SQL_ACCESS_MODE=unrestricted
# AZURE_SQL_PROFILE=
# AZURE_SQL_TOOL_GROUPS=all
# AZURE_SQL_WRITE_POLICY=apply
# The SQL principal must have no database lifecycle permission; see SECURITY.md.

# SQL auth fallback
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=

# Service principal auth
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
